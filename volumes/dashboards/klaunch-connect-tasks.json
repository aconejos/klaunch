  "iteration": 1700000000000,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Running tasks (per connector)",
      "datasource": "Prometheus",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "kafka_connect_connect_worker_metrics_connector_running_task_count",
          "legendFormat": "{{connector}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}}
    },
    {
      "type": "stat",
      "title": "Failed tasks (per connector)",
      "datasource": "Prometheus",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "targets": [
        {
          "expr": "kafka_connect_connect_worker_metrics_connector_failed_task_count",
          "legendFormat": "{{connector}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "type": "stat",
      "title": "Paused tasks (per connector)",
      "datasource": "Prometheus",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
      "targets": [
        {
          "expr": "kafka_connect_connect_worker_metrics_connector_paused_task_count",
          "legendFormat": "{{connector}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}]}}}
    },
    {
      "type": "timeseries",
      "title": "Source record write rate (per connector task)",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {
          "expr": "kafka_connect_source_task_metrics_source_record_write_rate",
          "legendFormat": "{{connector}} / task {{task}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "type": "timeseries",
      "title": "Source record poll rate (per connector task)",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {
          "expr": "kafka_connect_source_task_metrics_source_record_poll_rate",
          "legendFormat": "{{connector}} / task {{task}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "type": "timeseries",
      "title": "Task errors (logged / record / failures / skipped / retries)",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "targets": [
        {"expr": "kafka_connect_task_error_metrics_total_errors_logged", "legendFormat": "logged {{connector}}/t{{task}}", "refId": "A"},
        {"expr": "kafka_connect_task_error_metrics_total_record_errors", "legendFormat": "record_errors {{connector}}/t{{task}}", "refId": "B"},
        {"expr": "kafka_connect_task_error_metrics_total_record_failures", "legendFormat": "failures {{connector}}/t{{task}}", "refId": "C"},
        {"expr": "kafka_connect_task_error_metrics_total_records_skipped", "legendFormat": "skipped {{connector}}/t{{task}}", "refId": "D"},
        {"expr": "kafka_connect_task_error_metrics_total_retries", "legendFormat": "retries {{connector}}/t{{task}}", "refId": "E"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "timeseries",
      "title": "Dead-letter queue produce requests",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "targets": [
        {
          "expr": "kafka_connect_task_error_metrics_deadletterqueue_produce_requests",
          "legendFormat": "{{connector}} / task {{task}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "timeseries",
      "title": "Worker rebalance activity",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "targets": [
        {"expr": "kafka_connect_connect_worker_rebalance_metrics_rebalance_avg_time_ms", "legendFormat": "avg time (ms)", "refId": "A"},
        {"expr": "kafka_connect_connect_worker_rebalance_metrics_time_since_last_rebalance_ms", "legendFormat": "since last (ms)", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    },
    {
      "type": "timeseries",
      "title": "Sink task put batch time",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
      "targets": [
        {"expr": "kafka_connect_sink_task_metrics_put_batch_avg_time_ms", "legendFormat": "avg {{connector}}/t{{task}}", "refId": "A"},
        {"expr": "kafka_connect_sink_task_metrics_put_batch_max_time_ms", "legendFormat": "max {{connector}}/t{{task}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    },
    {
      "type": "row",
      "title": "MongoDB Sink Task",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 30},
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "MongoDB records written (rate)",
      "description": "records-successful: total records the MongoDB sink task successfully wrote to MongoDB",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 31},
      "targets": [
        {"expr": "rate(com_mongodb_kafka_connect_sink_task_metrics_records_successful[1m])", "legendFormat": "{{connector}} / {{task}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "type": "timeseries",
      "title": "Kafka-vs-Sink lag",
      "description": "latest-kafka-time-difference-ms: time diff between the sink task clock and the timestamp of the last record received. Rises when the sink falls behind.",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 31},
      "targets": [
        {"expr": "com_mongodb_kafka_connect_sink_task_metrics_latest_kafka_time_difference_ms", "legendFormat": "{{connector}} / {{task}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    },
    {
      "type": "stat",
      "title": "Total records written (since restart)",
      "description": "records-successful cumulative",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 31},
      "targets": [
        {"expr": "com_mongodb_kafka_connect_sink_task_metrics_records_successful", "legendFormat": "{{connector}} / {{task}}", "refId": "A"}
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}}
    },
    {
      "type": "timeseries",
      "title": "put() calls / sec + avg latency",
      "description": "in-task-put: number of Kafka Connect framework put() invocations on the MongoDB sink task. Avg latency = in-task-put-duration-ms / in-task-put.",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 39},
      "targets": [
        {"expr": "rate(com_mongodb_kafka_connect_sink_task_metrics_in_task_put[1m])", "legendFormat": "puts/s {{connector}}/{{task}}", "refId": "A"},
        {"expr": "rate(com_mongodb_kafka_connect_sink_task_metrics_in_task_put_duration_ms[1m]) / clamp_min(rate(com_mongodb_kafka_connect_sink_task_metrics_in_task_put[1m]), 0.0001)", "legendFormat": "avg ms/put {{connector}}/{{task}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "timeseries",
      "title": "Kafka Connect framework overhead",
      "description": "in-connect-framework: time spent in framework code between put() invocations. Avg = in-connect-framework-duration-ms / in-connect-framework. Excludes task code time.",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 39},
      "targets": [
        {"expr": "rate(com_mongodb_kafka_connect_sink_task_metrics_in_connect_framework[1m])", "legendFormat": "framework calls/s {{connector}}/{{task}}", "refId": "A"},
        {"expr": "rate(com_mongodb_kafka_connect_sink_task_metrics_in_connect_framework_duration_ms[1m]) / clamp_min(rate(com_mongodb_kafka_connect_sink_task_metrics_in_connect_framework[1m]), 0.0001)", "legendFormat": "avg ms {{connector}}/{{task}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "timeseries",
      "title": "SMT / processing phase time",
      "description": "processing-phases: batches processed by the MongoDB sink task before writing to MongoDB (includes Single Message Transforms). Avg = processing-phases-duration-ms / processing-phases.",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 47},
      "targets": [
        {"expr": "rate(com_mongodb_kafka_connect_sink_task_metrics_processing_phases[1m])", "legendFormat": "phases/s {{connector}}/{{task}}", "refId": "A"},
        {"expr": "rate(com_mongodb_kafka_connect_sink_task_metrics_processing_phases_duration_ms[1m]) / clamp_min(rate(com_mongodb_kafka_connect_sink_task_metrics_processing_phases[1m]), 0.0001)", "legendFormat": "avg ms {{connector}}/{{task}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "timeseries",
      "title": "Batch writes to MongoDB (rate + avg latency)",
      "description": "batch-writes-successful: batches the MongoDB sink task wrote to MongoDB. Avg latency = batch-writes-successful-duration-ms / batch-writes-successful.",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 47},
      "targets": [
        {"expr": "rate(com_mongodb_kafka_connect_sink_task_metrics_batch_writes_successful[1m])", "legendFormat": "batches/s {{connector}}/{{task}}", "refId": "A"},
        {"expr": "rate(com_mongodb_kafka_connect_sink_task_metrics_batch_writes_successful_duration_ms[1m]) / clamp_min(rate(com_mongodb_kafka_connect_sink_task_metrics_batch_writes_successful[1m]), 0.0001)", "legendFormat": "avg ms/batch {{connector}}/{{task}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    }
  ],
